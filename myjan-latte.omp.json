{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#4c4f69",
    "black": "#dce0e8",
    "yellow": "#df8e1d",
    "orange": "#fe640b",
    "blue": "#1e66f5"
  },
  "transient_prompt": {
    "template": "<#ea76cb> {{ .Folder }}</> <p:yellow>❯</> ",
    "right_template": "{{ if .Executed }}<#9ca0b0> {{ .Segments.Executiontime.FormattedMs }}</>{{ end }}",
    "foreground": "p:white",
    "background": "transparent"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent></><,p:yellow> > </><p:yellow,transparent></> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#eff1f5",
          "background": "#8839ef",
          "type": "os",
          "style": "diamond"
        },
        {
          "options": {
            "folder_separator_icon": "  ",
            "home_icon": "~",
            "max_depth": 3,
            "style": "letter"
          },
          "template": "   {{ .Path }} ",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "background": "#ea76cb",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "background": "#df8e1d",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#fe640b{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#d20f39{{ end }}",
            "{{ if gt .Ahead 0 }}#7287fd{{ end }}",
            "{{ if gt .Behind 0 }}#7287fd{{ end }}"
          ]
        },
        {
          "options": {
            "display_mode": "always",
            "fetch_version": true
          },
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#eff1f5",
          "powerline_symbol": "",
          "background": "#40a02c",
          "type": "node",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#eff1f5",
          "powerline_symbol": "",
          "background": "#209fb5",
          "type": "go",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#eff1f5",
          "background": "#7287fd",
          "powerline_symbol": "",
          "type": "elixir",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#eff1f5",
          "powerline_symbol": "",
          "background": "#1e66f5",
          "type": "julia",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "background": "#df8e1d",
          "type": "python",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "always",
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#eff1f5",
          "powerline_symbol": "",
          "background": "#d20f39",
          "type": "ruby",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": false
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "background": "#fe640b",
          "type": "azfunc",
          "style": "powerline"
        },
        {
          "options": {
            "display_default": false
          },
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "foreground": "#eff1f5",
          "powerline_symbol": "",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#fe640b{{end}}",
            "{{if contains \"jan\" .Profile}}#e64553{{end}}"
          ]
        },
        {
          "template": "  ",
          "foreground": "#4c4f69",
          "powerline_symbol": "",
          "background": "#dc8a78",
          "type": "root",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "type": "executiontime",
          "style": "plain",
          "foreground": "#eff1f5",
          "background": "#4c4f69",
          "template": "<#4c4f69,transparent></>  {{ .FormattedMs }} <transparent,#4c4f69></>"
        },
        {
          "options": {
            "always_enabled": true
          },
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "foreground": "#eff1f5",
          "background": "#40a02c",
          "background_templates": ["{{ if gt .Code 0 }}#d20f39{{ end }}"],
          "template": "  {{ if gt .Code 0 }}{{ reason .Code }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "template": "❯ ",
          "foreground": "p:yellow",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "tooltips": [
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "foreground": "#4c4f69",
      "background": "#fe640b",
      "type": "aws",
      "style": "diamond",
      "tips": ["aws"]
    },
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Name }} ",
      "foreground": "p:black",
      "background": "p:blue",
      "type": "az",
      "style": "diamond",
      "tips": ["az"]
    }
  ],
  "version": 4,
  "final_space": true
}
