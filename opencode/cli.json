{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "indicators": "status"
  },
  "debug": {
    "devtools": true,
    "timing": true,
    "turn_tokens": "verbose"
  }
}
