{
  "$schema": "https://opencode.ai/config.json",

  // Model ids are env-substituted so the same dotfiles work on every machine.
  // Values live outside the repo, in ~/.env (sourced by zshrc) - see MODELS.md.
  // `{env:VAR}` only works in this config file, not in agents/*.md frontmatter,
  // and is evaluated by the background service, so run `opencode service restart`
  // after changing the values.
  "model": "ollama/{env:OC_MODEL_CODER}",
  "small_model": "ollama/{env:OC_MODEL_SMALL}",
  "disabled_providers": ["amazon-bedrock"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "not-needed",
      },
      "models": {
        // Keys are substituted too (before the JSON is parsed), so the same
        // entry tracks whatever model id the env var holds.
        "{env:OC_MODEL_CODER}": {
          "name": "Coder (OC_MODEL_CODER)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 },
        },
        "{env:OC_MODEL_REVIEWER}": {
          "name": "Reviewer (OC_MODEL_REVIEWER)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 },
        },
        "{env:OC_MODEL_THINKER}": {
          "name": "Thinker (OC_MODEL_THINKER)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 },
        },
        "{env:OC_MODEL_SMALL}": {
          "name": "Small (OC_MODEL_SMALL)",
          "tool_call": true,
          "limit": { "context": 16384, "output": 2048 },
        },
      },
    },
  },
  // Agent ids are derived from the file name, so `Code-Reviewer` keeps its capital C.
  // A `model:` in the agent's frontmatter would win over these - that's why the
  // frontmatter no longer sets one.
  "agents": {
    "code-writer": { "model": "ollama/{env:OC_MODEL_CODER}" },
    "Code-Reviewer": { "model": "ollama/{env:OC_MODEL_REVIEWER}" },
    "thinker": { "model": "ollama/{env:OC_MODEL_THINKER}" },
  },
  "plugin": ["@mohak34/opencode-notifier"],
}
