{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/llama3.2:latest",
  "small_model": "ollama/dagbs/qwen2.5-coder-1.5b-instruct-abliterated:q4_k_m",
  "disabled_providers": ["amazon-bedrock"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "llama3.2:latest": {
          "name": "llama3.2",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 },
        },
        "dagbs/qwen2.5-coder-1.5b-instruct-abliterated:q4_k_m": {
          "name": "qwen2.5-coder-1.5b (abliterated)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 },
        },
      },
    },
  },
  "plugin": ["@mohak34/opencode-notifier"],
}
