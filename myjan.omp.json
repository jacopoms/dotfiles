{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#cdd6f4",
    "black": "#11111b",
    "yellow": "#f9e2af",
    "orange": "#fab387",
    "blue": "#89b4fa"
  },
  "transient_prompt": {
    "template": "<#f5c2e7>\uea83 {{ .Folder }}</> <p:yellow>\u276f</> ",
    "right_template": "{{ if .Executed }}<#6c7086>\ueba2 {{ .Segments.Executiontime.FormattedMs }}</>{{ end }}",
    "foreground": "p:white",
    "background": "transparent"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent>\ue0b6</><,p:yellow> > </><p:yellow,transparent>\ue0b0</> ",
    "foreground": "p:black",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#11111b",
          "background": "#cba6f7",
          "type": "os",
          "style": "diamond"
        },
        {
          "options": {
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "max_depth": 3,
            "style": "letter"
          },
          "template": " \uea83  {{ .Path }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#f5c2e7",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#f9e2af",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#fab387{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f38ba8{{ end }}",
            "{{ if gt .Ahead 0 }}#b4befe{{ end }}",
            "{{ if gt .Behind 0 }}#b4befe{{ end }}"
          ]
        },
        {
          "options": {
            "display_mode": "always",
            "fetch_version": true
          },
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#a6e3a1",
          "type": "node",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#74c7ec",
          "type": "go",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "context",
            "fetch_version": true
          },
          "template": " \ue624 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "background": "#b4befe",
          "powerline_symbol": "\ue0b0",
          "type": "elixir",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": " \ue624 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#89b4fa",
          "type": "julia",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#f9e2af",
          "type": "python",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "always",
            "fetch_version": true
          },
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#f38ba8",
          "type": "ruby",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": false
          },
          "template": " \uf0e7{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#fab387",
          "type": "azfunc",
          "style": "powerline"
        },
        {
          "options": {
            "display_default": false
          },
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#fab387{{end}}",
            "{{if contains \"jan\" .Profile}}#eba0ac{{end}}"
          ]
        },
        {
          "template": " \uf0ad ",
          "foreground": "#11111b",
          "powerline_symbol": "\ue0b0",
          "background": "#f5e0dc",
          "type": "root",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "type": "executiontime",
          "style": "plain",
          "foreground": "#11111b",
          "background": "#cdd6f4",
          "template": "<#cdd6f4,transparent>\ue0b6</> \ueba2 {{ .FormattedMs }} <transparent,#cdd6f4>\ue0b2</>"
        },
        {
          "options": {
            "always_enabled": true
          },
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#11111b",
          "background": "#a6e3a1",
          "background_templates": ["{{ if gt .Code 0 }}#f38ba8{{ end }}"],
          "template": " \ue23a {{ if gt .Code 0 }}{{ reason .Code }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "template": "\u276f ",
          "foreground": "p:yellow",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "tooltips": [
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "foreground": "p:black",
      "background": "p:orange",
      "type": "aws",
      "style": "diamond",
      "tips": ["aws"]
    },
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \uebd8 {{ .Name }} ",
      "foreground": "p:black",
      "background": "p:blue",
      "type": "az",
      "style": "diamond",
      "tips": ["az"]
    }
  ],
  "version": 4,
  "final_space": true
}
